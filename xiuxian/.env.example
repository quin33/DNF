# 复制为 .env，并只在服务器本机填写真实值；不要提交 .env。
ADMIN_PASSWORD=Admin
CONTROL_PANEL_PASSWORD=请替换为本机控制台专用高强度密码
CONTROL_PANEL_PORT=8790
GAME_PORT=8787
AI_ENABLED=true
AI_BASE_URL=11111
AI_API_KEY=1111
AI_MODEL=DeepSeek V4 Flash
AI_MAX_TOKENS=8000
AI_TEMPERATURE=1.0

# 置于可信反向代理（Nginx/Caddy）之后时设为 true，以读取 X-Forwarded-For 真实客户端 IP；直连时保持 false，避免伪造 IP 绕过限流。
TRUST_PROXY=false
