# 复制为 .env，并只在服务器本机填写真实值；不要提交 .env。
ADMIN_PASSWORD=请替换为高强度独立的管理员密码
CONTROL_PANEL_PASSWORD=请替换为本机控制台专用高强度密码

# 端口：DNF 用 8788/8791，避免与原游戏 xiuxian（8787/8790）冲突。
# PORT 与 GAME_PORT 都要设：server.js 读 PORT，控制台读 GAME_PORT 后转成 PORT 传给子进程。
# 只设 GAME_PORT 的话，直接 node server.js 会回落到 8787 抢占原游戏端口。
PORT=8788
GAME_PORT=8788
CONTROL_PANEL_PORT=8791

# 数据库与原游戏分开，两边账号和角色数据互不影响。
TAVERN_DB_PATH=./dnf.db

AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=请填入你自己的 API Key
AI_MODEL=deepseek-chat
AI_MAX_TOKENS=8000
AI_TEMPERATURE=1.0

# 统一控制台（8792，一个页面同时管问道仙坊和 DNF）。全部可选。
# 密码按 UNIFIED_PANEL_PASSWORD → CONTROL_PANEL_PASSWORD 回退，
# 所以上面设过 CONTROL_PANEL_PASSWORD 就不用再配；两者都没设时进程拒绝启动。
UNIFIED_PANEL_PORT=8792
# UNIFIED_PANEL_HOST=127.0.0.1
# UNIFIED_PANEL_PASSWORD=想给统一控制台单独设密码时才填
# UNIFIED_AUTO_START=true
# 管哪几个游戏。必须写成单行 JSON 数组，字段 id/name/dir/port，entry 可选（默认 server.js）。
# 不设则等价于下面这行。
# UNIFIED_GAMES=[{"id":"xiuxian","name":"问道仙坊","dir":"I:\\DEEPSEEK\\tavern_clone","port":8787},{"id":"dnf","name":"DNF","dir":"I:\\DEEPSEEK\\DNF","port":8788}]

# 站点网关：两个游戏挂到同一个域名的两个子路径下，由统一控制台一起拉起。
#   https://xiuxiangame.dpdns.org/          导航首页
#   https://xiuxiangame.dpdns.org/xiuxian/  → 8787
#   https://xiuxiangame.dpdns.org/dnf/      → 8788
# 网关负责剥掉 /dnf 这层前缀再转发，两个游戏的 server.js 因此完全不用感知路径。
# cloudflared 里主域名要指向 GATEWAY_PORT；改成 false 就退回一个游戏一个子域名的老做法。
UNIFIED_GATEWAY=true
GATEWAY_PORT=8786
GATEWAY_HOST=127.0.0.1
# 站点清单，单行 JSON 数组，字段 prefix/name/port，tagline 可选。不设则等价于下面这行。
# GATEWAY_SITES=[{"prefix":"xiuxian","name":"问道仙坊","port":8787},{"prefix":"dnf","name":"DNF","port":8788}]

# 账号镜像：让两个游戏共用同一账号（角色仍各自独立）。
# 填另一个游戏的 SQLite 库绝对路径。本游戏登录时若本地没有该账号，就去镜像库验证
# 密码，匹配则自动在本地补建同名账号；注册时用户名在两个库里都不得重复。
# 不设则两个游戏各自独立注册。两边要互指：DNF 填问道仙坊的库，问道仙坊填 DNF 的库。
# ACCOUNT_MIRROR_DB=I:/DEEPSEEK/tavern_clone/tavern.db

# 置于可信反向代理（Nginx/Caddy）之后时设为 true，以读取 X-Forwarded-For 真实客户端 IP；直连时保持 false，避免伪造 IP 绕过限流。
TRUST_PROXY=false
