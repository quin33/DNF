+const ROOT = path.resolve(__dirname, '..');
+const suffix = `admin-api-${process.pid}-${Date.now()}`;
+const adminPassword = `secret-${suffix}`;
+const username = `player-${suffix}`;
+const originalCharacter = {
+  name: `Fixture ${suffix}`,
