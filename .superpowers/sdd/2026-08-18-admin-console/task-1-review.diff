+    VALUES (?,?,?,?,?)
+  `).run(userId, characterId, now, JSON.stringify(adminCharacterSnapshot(before)), JSON.stringify(adminCharacterSnapshot(after)));
+  return info.lastInsertRowid;
+}
+function getAdminAuditLogs(charId) {
